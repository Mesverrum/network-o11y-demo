          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "device_name",
                "snmp_tier",
                "sysObjectID",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "device_name": 0,
              "snmp_tier": 1,
              "sysObjectID": 2
            },
            "renameByName": {
