{
  "uid": "hub-discovery",
  "title": "Hub 2 \u00b7 Discovery",
  "description": "What the hub discovery group found on its collector.",
  "tags": [
    "network-instrumentation-hub"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Stack",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "marcnetterfield1-prom",
          "value": "mf1-prom"
        },
        "hide": 0
      },
      {
        "name": "collector",
        "label": "Collector",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(discovery_snmp_group_info, collector)",
          "refId": "collector"
        },
        "definition": "label_values(discovery_snmp_group_info, collector)",
        "current": {
          "text": "hub-canary",
          "value": "hub-canary"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "group",
        "label": "Group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(discovery_snmp_group_info{collector=\"$collector\"}, group)",
          "refId": "group"
        },
        "definition": "label_values(discovery_snmp_group_info{collector=\"$collector\"}, group)",
        "current": {
          "text": "hub-demo",
          "value": "hub-demo"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Hub dashboards",
      "type": "dashboards",
      "tags": [
        "network-instrumentation-hub"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Receiving",
      "type": "link",
      "url": "/a/mesverrum-networkinstrumentationhub-app/receiving",
      "icon": "arrow-right"
    }
  ],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Did discovery find what the group asked for?** `discovery_snmp_group_info` echoes the group and note back from the collector; `discovery_snmp_device_info` is one row per device that answered."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Group reported",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "count(count by (group) (discovery_snmp_group_info{collector=\"$collector\",group=\"$group\"})) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000000.0,
                "result": {
                  "text": "Yes",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Waiting"
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Devices found",
      "description": "Counted once per device, even while an old pipeline revision is going stale.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "count(count by (device_name, address) (discovery_snmp_device_info{collector=\"$collector\",group=\"$group\"})) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Waiting"
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Scrape targets (all tiers)",
      "description": "Targets discovery handed to the hot, cold, and topology scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum(discovery_snmp_targets_by_tier{collector=\"$collector\"}) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "Waiting"
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Scans (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum(increase(discovery_snmp_scans_total{collector=\"$collector\"}[24h])) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "Waiting"
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Scan failures (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum(increase(discovery_snmp_scan_failures_total{collector=\"$collector\"}[24h])) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "Waiting"
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Login failures (1h)",
      "description": "Addresses that answered but refused every login in the group. Some are expected on a shared subnet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 20,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum(increase(discovery_snmp_auth_failures_total{collector=\"$collector\"}[1h])) or vector(0)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "noValue": "Waiting"
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "table",
      "title": "Group as the collector sees it",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "discovery_snmp_group_info{collector=\"$collector\",group=\"$group\"}",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "group",
                "description",
                "collector",
                "component_path",
                "hub_revision"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value": true
            },
            "indexByName": {
              "group": 0,
              "description": 1,
              "collector": 2,
              "component_path": 3,
              "hub_revision": 4
            },
            "renameByName": {
              "group": "Group",
              "description": "Note",
              "collector": "Collector",
              "component_path": "Fleet module",
              "hub_revision": "Revision"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Devices found",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "max by (device_name, address, auth, sysObjectID) (discovery_snmp_device_info{collector=\"$collector\",group=\"$group\"})",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "device_name",
                "address",
                "auth",
                "sysObjectID"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value": true
            },
            "indexByName": {
              "device_name": 0,
              "address": 1,
              "auth": 2,
              "sysObjectID": 3
            },
            "renameByName": {
              "device_name": "Device",
              "address": "Address",
              "auth": "Login",
              "sysObjectID": "sysObjectID"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Targets by tier",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum by (tier) (discovery_snmp_targets_by_tier{collector=\"$collector\"})",
          "legendFormat": "{{tier}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Probe outcomes",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "A",
          "expr": "sum(rate(discovery_snmp_probes_total{collector=\"$collector\"}[5m]))",
          "legendFormat": "probes/s",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "B",
          "expr": "sum(rate(discovery_snmp_auth_failures_total{collector=\"$collector\"}[5m]))",
          "legendFormat": "login failures/s",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "refId": "C",
          "expr": "sum(rate(discovery_snmp_scan_failures_total{collector=\"$collector\"}[5m]))",
          "legendFormat": "scan failures/s",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "id": 11
    }
  ]
}
