apiVersion: apps/v1
kind: Deployment
metadata:
  name: alloy
  namespace: network-lab
  labels:
    app: alloy
    component: ktranslate-golden
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: alloy
  template:
    metadata:
      labels:
        app: alloy
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      containers:
        - name: alloy
          image: __ALLOY_IMAGE__
          imagePullPolicy: IfNotPresent
          args:
            - run
            - /etc/alloy/config.alloy
            - --storage.path=/var/lib/alloy/data
            - --server.http.listen-addr=0.0.0.0:12346
            - --stability.level=experimental
          env:
            - name: GC_OTLP_URL
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_URL
            - name: GC_OTLP_ACCOUNT
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_ACCOUNT
            - name: GC_OTLP_KEY
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_KEY
            - name: GC_OTLP_URL_2
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_URL_2
                  optional: true
            - name: GC_OTLP_ACCOUNT_2
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_ACCOUNT_2
                  optional: true
            - name: GC_OTLP_KEY_2
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_KEY_2
                  optional: true
            - name: GC_OTLP_URL_3
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_URL_3
                  optional: true
            - name: GC_OTLP_ACCOUNT_3
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_ACCOUNT_3
                  optional: true
            - name: GC_OTLP_KEY_3
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_KEY_3
                  optional: true
            - name: OTEL_METRIC_EXPORT_INTERVAL
              value: "1000"
            - name: OTEL_RESOURCE_ATTRIBUTES
              value: "deployment.host=__KTRANS_HOST__"
            - name: SNMP_COMMUNITY
              value: "public"
            - name: SNMP_AUTHS
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: SNMP_AUTHS
                  optional: true
            - name: KTRANS_HOST
              value: "__KTRANS_HOST__"
            - name: GC_FM_TOKEN
              valueFrom:
                secretKeyRef:
                  name: grafana-cloud-credentials
                  key: GC_OTLP_KEY
          securityContext:
            capabilities:
              add: ["NET_RAW"]
          ports:
            - name: otlp-grpc
              containerPort: 4317
              protocol: TCP
            - name: ui
              containerPort: 12346
              protocol: TCP
            - name: netflow
              containerPort: 2055
              protocol: UDP
            - name: sflow
              containerPort: 6344
              protocol: UDP
          # Do not declare 1620/1514 here: hostNetwork port claims block
          # ktranslate SNMP/syslog when those collectors are scaled up.
          # Alloy still binds them from River when LAB_ALLOY_SNMPTRAP/SYSLOG=1.
          volumeMounts:
            - name: config
              mountPath: /etc/alloy/config.alloy
              subPath: config.alloy
              readOnly: true
            - name: snmp-sd
              mountPath: /snmp-sd
              readOnly: true
            - name: snmp-sd
              mountPath: /etc/alloy/snmp-discovery.yml
              subPath: snmp-discovery.yml
              readOnly: true
            - name: snmp-sd
              mountPath: /etc/alloy/snmp-overrides.yml
              subPath: snmp-overrides.yml
              readOnly: true
            - name: snmp-sd
              mountPath: /etc/alloy/device-join.yml
              subPath: device-join.yml
              readOnly: true
            - name: snmp-sd
              mountPath: /etc/alloy/snmp-targets.yml
              subPath: snmp-targets.yml
              readOnly: true
            - name: snmp-sd
              mountPath: /etc/alloy/snmp-targets-cold.yml
              subPath: snmp-targets-cold.yml
              readOnly: true
            - name: storage
              mountPath: /var/lib/alloy/data
            - name: docker-sock
              mountPath: /var/run/docker.sock
              readOnly: true
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
      volumes:
        - name: config
          configMap:
            name: alloy-config
        - name: snmp-sd
          hostPath:
            path: /opt/network-o11y-demo/local/alloy
            type: Directory
        - name: storage
          emptyDir: {}
        - name: docker-sock
          hostPath:
            path: /var/run/docker.sock
            type: Socket
