# Branch 2 SNMP group (leaf-br2) — colocated multi-group demo.
#   cp groups/srl-branch2.env.sample groups/srl-branch2.env

GROUP=srl-branch2
SITE=branch2

SNMP_VERSION=v2c
SNMP_V2_COMMUNITY=public
TRAP_COMMUNITY=public

DISCOVERY_SOURCE=cidr
TARGETS=172.20.20.0/24

METALISTEN_PORT=9993
TRAP_PORT=1622

DISCOVERY_THREADS=2
POLL_INTERVAL_SEC=60
