# Branch 1 SNMP group (leaf-br1) — colocated multi-group demo.
#   cp groups/srl-branch1.env.sample groups/srl-branch1.env

GROUP=srl-branch1
SITE=branch1

SNMP_VERSION=v2c
SNMP_V2_COMMUNITY=public
TRAP_COMMUNITY=public

DISCOVERY_SOURCE=cidr
TARGETS=172.20.20.0/24

METALISTEN_PORT=9999
TRAP_PORT=1621

DISCOVERY_THREADS=2
POLL_INTERVAL_SEC=60
