# Clos fabric SNMP group (spine1, leaf1, leaf2) — laptop single-group default.
# Copy to groups/srl.env (without .sample).
#
#   cp groups/srl.env.sample groups/srl.env
#   make generate && make up && make discover GROUP=srl
#
# GROUP= becomes label snmp_group on all SNMP metrics from this poller (global.user_tags).
# Colocated (HQ + branches): use srl-hq / srl-branch1 / srl-branch2 samples instead —
#   LAB_FABRIC_PROFILE=colocated bash scripts/colocated-snmp-groups.sh
#
# Default: CIDR discovery — `make up` rewrites TARGETS to live clab mgmt /32s
# (scripts/update-snmp-targets.sh). Set SNMP_TARGETS_MODE=subnet to scan /24 instead.
# Optional NetBox Cloud: copy groups/srl.env.netbox.sample instead (see local/netbox/README.md).

GROUP=srl

SNMP_VERSION=v2c
SNMP_V2_COMMUNITY=public
TRAP_COMMUNITY=public

DISCOVERY_SOURCE=cidr
# ContainerLab mgmt subnet — synced from live `clab` IPAM on make up / stabilize
# (scripts/update-snmp-targets.sh), then ktranslate discovery scans TARGETS.
TARGETS=172.20.20.0/24

METALISTEN_PORT=9997
TRAP_PORT=1620

DISCOVERY_THREADS=4
POLL_INTERVAL_SEC=60
