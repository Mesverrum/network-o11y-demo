# HQ site SNMP group (spine1, leaf1, leaf2) — colocated multi-group demo.
#   cp groups/srl-hq.env.sample groups/srl-hq.env
#
# Use with LAB_FABRIC_PROFILE=colocated alongside srl-branch1.env + srl-branch2.env.
# GROUP= becomes snmp_group on metrics from this poller (global.user_tags).
# SITE= scopes discovery TARGETS to HQ nodes (update-snmp-targets.sh).

GROUP=srl-hq
SITE=hq

SNMP_VERSION=v2c
SNMP_V2_COMMUNITY=public
TRAP_COMMUNITY=public

DISCOVERY_SOURCE=cidr
TARGETS=172.20.20.0/24

METALISTEN_PORT=9997
TRAP_PORT=1620

DISCOVERY_THREADS=4
POLL_INTERVAL_SEC=60
