# Clos fabric SNMP group — HQ site (spine1, leaf1, leaf2).
# Laptop default and AWS/colocated HQ poller (tags_snmp_group=srl-hq).
#
#   cp groups/srl-hq.env.sample groups/srl-hq.env
#   make generate && make up
#
# Colocated EC2 also uses srl-branch1 + srl-branch2 — see scripts/colocated-snmp-groups.sh.
# GROUP= becomes tags_snmp_group on metrics (poller global.user_tags).
# SITE= scopes discovery TARGETS to HQ nodes (update-snmp-targets.sh).

GROUP=srl-hq
SITE=hq

SNMP_VERSION=v2c
SNMP_V2_COMMUNITY=public
TRAP_COMMUNITY=public

DISCOVERY_SOURCE=cidr
# Rewritten to live clab mgmt /32s on make up / stabilize (update-snmp-targets.sh).
TARGETS=172.20.20.0/24

METALISTEN_PORT=9997
TRAP_PORT=1620

DISCOVERY_THREADS=4
POLL_INTERVAL_SEC=60
