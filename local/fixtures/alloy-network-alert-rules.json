    {
      "uid": "na-bgp-session-not-established",
      "title": "Alloy: BGP session not established",
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "expr": "snmp_tBgpPeerNgConnState{job=\"alloy-snmp\"} != 6",
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
