[Unit]
Description=Lab circuit fault webhook (Grafana dashboard toggle)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/lab-fault-webhook.env
ExecStart=/usr/bin/python3 /opt/network-o11y-demo/local/scripts/lab-fault-webhook.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
